{
  "name": "shipsaas-template",
  "version": "1.0.0",
  "description": "Premium Next.js SaaS Template - Ship your SaaS in days with authentication, payments, 55+ components, and production-ready code.",
  "author": "ShipSaaS",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "keywords": [
    "nextjs",
    "saas",
    "template",
    "starter",
    "boilerplate",
    "stripe",
    "lemonsqueezy",
    "supabase",
    "authentication",
    "payments",
    "typescript",
    "tailwindcss",
    "drizzle-orm",
    "postgresql"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/shipsaas-template"
  },
  "bugs": {
    "url": "https://github.com/yourusername/shipsaas-template/issues",
    "email": "support@yourdomain.com"
  },
  "homepage": "https://yourdomain.com",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier . --write",
    "assets:generate": "node scripts/generate-assets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:init": "tsx scripts/init-db.ts",
    "email:test": "tsx scripts/test-email.ts",
    "prepare": "husky",
    "docker:dev": "docker-compose -f docker/dev/docker-compose.yml up",
    "docker:dev:postgres": "docker-compose -f docker/dev/docker-compose.postgres.yml up",
    "docker:dev:mongodb": "docker-compose -f docker/dev/docker-compose.mongodb.yml up",
    "docker:dev:down": "docker-compose -f docker/dev/docker-compose.yml down",
    "docker:prod": "docker-compose -f docker/prod/docker-compose.yml up -d",
    "docker:prod:postgres": "docker-compose -f docker/prod/docker-compose.postgres.yml up -d",
    "docker:prod:mongodb": "docker-compose -f docker/prod/docker-compose.mongodb.yml up -d",
    "docker:prod:build": "docker-compose -f docker/prod/docker-compose.yml up -d --build",
    "docker:logs": "docker-compose -f docker/prod/docker-compose.yml logs -f",
    "docker:down": "docker-compose -f docker/prod/docker-compose.yml down"
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.2",
    "@stripe/stripe-js": "^5.6.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "form-data": "^4.0.1",
    "framer-motion": "^12.0.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.474.0",
    "mailgun.js": "^11.1.0",
    "marked": "^17.0.1",
    "next": "^16.2.7",
    "pg": "^8.13.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.4.0",
    "stripe": "^17.6.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/pg": "^8.11.11",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "postcss": "^8",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10"
}
