# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Default ignored files
/shelf/
/workspace.xml
# Editor-based HTTP Client requests
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
.idea

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE and AI assistant folders
.vscode/
.claude/
.kiro/
.playwright-mcp/
.qwen/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local dev server logs
dev-server.log
dev-server.err.log

# Stale pnpm lockfile (this project is npm-only; pnpm-lock.yaml was
# accidentally committed at one point and breaks Vercel builds because
# pnpm@10 enforces lockfile/package.json integrity. Keep it ignored so
# running pnpm locally never re-introduces the conflict.)
pnpm-lock.yaml

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.docker
.env.production

# local ops runbook (contains live database credentials)
DB-SETUP-RUNBOOK.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#drizzle
/drizzle

