# ============================================================================
# SHIPSAAS - COMPLETE ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!
# ============================================================================
#
# Dev quickstart: the lazy server clients (Stripe, Drizzle, Supabase admin)
# are Proxy-wrapped, so `npm run dev` boots and serves the public pages
# (landing, blog, docs, playground, legal) with these placeholder values.
# You'll only need real values when you wire up Supabase / Stripe / Mailgun.
#
#   cp .env.example .env.local
#   npm run dev
#   open http://localhost:3000
# ============================================================================

# ============================================================================
# APP CONFIGURATION
# ============================================================================

# Your app name (displayed in emails, meta tags, etc.)
NEXT_PUBLIC_APP_NAME=ShipSaaS

# Your production URL (use http://localhost:3000 for development)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environment (development, production, test)
NODE_ENV=development

# ============================================================================
# SUPABASE - AUTHENTICATION & DATABASE
# ============================================================================

# Supabase Project URL
# Find at: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co

# Supabase Anon/Public Key (safe to expose to client)
# Find at: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBsYWNlaG9sZGVyIiwicm9sZSI6ImFub24iLCJpYXQiOjE2NDUxOTI4MDAsImV4cCI6MTk2MDc2ODgwMH0.placeholder

# Supabase Service Role Key (NEVER expose to client!)
# Find at: Supabase Dashboard > Project Settings > API
# Used for admin operations and webhook handlers
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Auth Webhook Secret (for syncing users to database)
# Generate with: openssl rand -hex 32
# Used to verify webhook requests from Supabase
SUPABASE_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================================
# DATABASE (PostgreSQL via Supabase)
# ============================================================================

# Direct database connection URL
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Find at: Supabase Dashboard > Project Settings > Database
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# ============================================================================
# PAYMENT PROVIDER CONFIGURATION
# ============================================================================

# Choose your payment provider: "stripe", "lemonsqueezy", or "both"
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe

# ----------------------------------------------------------------------------
# STRIPE
# ----------------------------------------------------------------------------

# Stripe Publishable Key (safe to expose to client)
# Find at: Stripe Dashboard > Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Stripe Secret Key (NEVER expose to client!)
# Find at: Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe Webhook Secret (for webhook signature verification)
# Find at: Stripe Dashboard > Developers > Webhooks > Add endpoint
# Webhook URL: https://yourdomain.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Optional: Stripe Price IDs for specific plans
# Find at: Stripe Dashboard > Products > Your Product > Pricing
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# LEMONSQUEEZY
# ----------------------------------------------------------------------------

# LemonSqueezy API Key
# Find at: LemonSqueezy Dashboard > Settings > API
LEMONSQUEEZY_API_KEY=your_api_key_here

# LemonSqueezy Store ID
# Find at: LemonSqueezy Dashboard > Settings > Stores
LEMONSQUEEZY_STORE_ID=your_store_id_here

# LemonSqueezy Webhook Secret (for webhook signature verification)
# Find at: LemonSqueezy Dashboard > Settings > Webhooks
# Webhook URL: https://yourdomain.com/api/lemonsqueezy/webhook
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here

# LemonSqueezy Variant ID (your product variant)
# Find at: LemonSqueezy Dashboard > Products > Your Product > Variants
NEXT_PUBLIC_LEMONSQUEEZY_VARIANT_ID=your_variant_id_here

# Optional: LemonSqueezy Variant IDs for specific plans
NEXT_PUBLIC_LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=123456
NEXT_PUBLIC_LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=123456
NEXT_PUBLIC_LEMONSQUEEZY_PREMIUM_VARIANT_ID=123456

# ============================================================================
# MAILGUN - EMAIL SERVICE
# ============================================================================

# Mailgun API Key (private API key)
# Find at: Mailgun Dashboard > Settings > API Keys
MAILGUN_API_KEY=your_mailgun_api_key_here

# Mailgun Domain (your verified domain)
# Example: mg.yourdomain.com
# Find at: Mailgun Dashboard > Sending > Domains
MAILGUN_DOMAIN=mg.yourdomain.com

# Mailgun Subdomain (the prefix of your domain)
# Example: If your domain is mg.yourdomain.com, this is "mg"
MAILGUN_SUBDOMAIN=mg

# Email addresses (customize these)
MAILGUN_FROM_EMAIL=noreply@mg.yourdomain.com
MAILGUN_FROM_NOREPLY=ShipSaaS <noreply@mg.yourdomain.com>
MAILGUN_FROM_ADMIN=Support <support@mg.yourdomain.com>
MAILGUN_SUPPORT_EMAIL=support@mg.yourdomain.com

# Email forwarding (where to forward received emails)
# Example: your personal Gmail or company email
MAILGUN_FORWARD_TO=admin@yourdomain.com

# Mailgun Webhook Signing Key (for email receiving webhook)
# Generate at: Mailgun Dashboard > Settings > Webhooks
MAILGUN_WEBHOOK_SIGNING_KEY=your_webhook_signing_key_here


# ============================================================================
# EMAIL BRAND (used by templates at src/lib/email-templates.ts)
# ============================================================================
# Override these to rebrand outgoing transactional email without touching code.
# If unset, the templates use the modern-minimal default (slate-indigo on paper).

# Display name in the email header (e.g. "Acme")
EMAIL_BRAND_NAME=ShipSaaS

# Product name in subject lines and body copy (e.g. "Acme Pro")
EMAIL_PRODUCT_NAME=ShipSaaS

# Reply-to / support address shown in the footer
EMAIL_SUPPORT_ADDRESS=support@shipsaas.dev

# Public logo URL embedded in the email header (PNG recommended, 22px tall)
# EMAIL_LOGO_URL=https://yourdomain.com/logo.png

# Brand colors (CSS color values; inlined into the HTML)
# EMAIL_PRIMARY_COLOR=#0b0f1a
# EMAIL_TEXT_COLOR=#0b0f1a
# EMAIL_MUTED_COLOR=#64748b
# EMAIL_BORDER_COLOR=#e2e8f0
# EMAIL_SURFACE_COLOR=#ffffff
# EMAIL_BACKGROUND_COLOR=#f8fafc

# Set to "true" to short-circuit Mailgun and log outgoing emails to the
# console (useful for local development and the /dev/emails preview).
# SKIP_EMAILS=false

# ============================================================================
# EMAIL LOG + DELIVERY TRACKING
# ============================================================================
#
# Every transactional send writes a row to the `email_log` table. The Mailgun
# inbound webhook updates each row's status when delivery events arrive.
#
# To enable, apply the migration:
#   psql $DATABASE_URL -f supabase/migrations/005_email_log.sql
#
# Then enable these Mailgun webhook events in the dashboard:
#   Delivered, Bounced, Complained, Unsubscribed, Failed
# pointing at: https://yourdomain.com/api/mailgun/webhook

# ============================================================================
# OPTIONAL: ADDITIONAL SERVICES
# ============================================================================

# ----------------------------------------------------------------------------
# Google OAuth (if you want social login)
# ----------------------------------------------------------------------------

# Set up at: https://console.cloud.google.com/
# Enable Google+ API and create OAuth 2.0 credentials
# Add to Supabase: Dashboard > Authentication > Providers > Google

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ----------------------------------------------------------------------------
# Analytics (optional)
# ----------------------------------------------------------------------------

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# PostHog (analytics + session replay, opt-in)
# The shim at src/lib/observability.ts no-ops unless NEXT_PUBLIC_POSTHOG_KEY
# is set AND the package is installed:
#   npm install posthog-js posthog-node
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# Error Tracking (optional)
# ----------------------------------------------------------------------------

# Sentry (errors + performance, opt-in)
# The shim at src/lib/observability.ts no-ops unless the DSN is set AND
# the package is installed:
#   npm install @sentry/nextjs
# Then run `npx @sentry/wizard@latest -i nextjs` to wire build/source maps.
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0

# Sentry auth token (used by the Sentry CLI to upload source maps)
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ----------------------------------------------------------------------------
# Customer Support (optional)
# ----------------------------------------------------------------------------

# Intercom
NEXT_PUBLIC_INTERCOM_APP_ID=your_intercom_app_id

# Crisp
NEXT_PUBLIC_CRISP_WEBSITE_ID=your_crisp_website_id

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Enable debug logging (true/false)
DEBUG=false

# Skip email sending in development (true/false)
# Set to "true" if you want to test without configuring Mailgun
# Emails will be logged to console instead of being sent
SKIP_EMAILS=true

# Test Stripe webhook locally (use Stripe CLI)
# Install: https://stripe.com/docs/stripe-cli
# Run: stripe listen --forward-to localhost:3000/api/stripe/webhook

# ============================================================================
# WAITLIST (optional pre-launch email capture at /waitlist)
# ============================================================================
# When NEXT_PUBLIC_WAITLIST_ENABLED=true, the /waitlist route is served and
# POSTs to /api/waitlist are stored in the `waitlist` table.
# When false (default), /waitlist returns 404 and the API is unreachable.
# Requires supabase/migrations/004_waitlist.sql to be applied to your DB.
# NEXT_PUBLIC_WAITLIST_ENABLED=false

# ============================================================================
# NOTES & REMINDERS
# ============================================================================

# 1. NEVER commit this file with real values!
#    Add .env.local to .gitignore (already done)

# 2. For production, set these in your hosting provider:
#    - Vercel: Project Settings > Environment Variables
#    - Railway: Project > Variables
#    - AWS/GCP: Use their secrets management

# 3. Required for basic functionality:
#    - SUPABASE (URL, ANON_KEY, SERVICE_ROLE_KEY)
#    - DATABASE_URL
#    - At least one payment provider (Stripe or LemonSqueezy)
#    - MAILGUN (for emails)

# 4. Optional but recommended:
#    - SUPABASE_WEBHOOK_SECRET (for user sync)
#    - *_WEBHOOK_SECRET variables (for security)
#    - GOOGLE OAuth (for social login)

# 5. To generate random secrets:
#    openssl rand -hex 32

# ============================================================================
# QUICK START CHECKLIST
# ============================================================================

# [ ] 1. Copy this file to .env.local
# [ ] 2. Fill in Supabase credentials (URL, keys)
# [ ] 3. Fill in Database URL
# [ ] 4. Choose and configure payment provider (Stripe/LemonSqueezy)
# [ ] 5. Configure Mailgun for emails
# [ ] 6. Generate webhook secrets
# [ ] 7. Set NEXT_PUBLIC_SITE_URL to your domain
# [ ] 8. Test locally with: npm run dev
# [ ] 9. Deploy and set environment variables in hosting provider
# [ ] 10. Configure DNS for Mailgun (SPF, DKIM, DMARC)

# ============================================================================
# HELPFUL LINKS
# ============================================================================

# Supabase Dashboard: https://app.supabase.com/
# Stripe Dashboard: https://dashboard.stripe.com/
# LemonSqueezy Dashboard: https://app.lemonsqueezy.com/
# Mailgun Dashboard: https://app.mailgun.com/
# Documentation: See README.md and guides in the docs folder
